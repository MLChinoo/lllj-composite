<Window x:Class="atri_composite.FolderSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择目录" Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        MinHeight="400" MinWidth="450"
        Icon="icon.ico">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="选择目录" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" />
            <TextBlock Text="请添加解包后的fgimage目录，如有adult和upgrade目录也一同添加（支持拖拽目录至下方列表）：" FontSize="12" Foreground="#7F8C8D"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Folder ListBox -->
            <ListBox x:Name="lstFolders" Grid.Column="0"
                     Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AllowDrop="True"
                     DragOver="LstFolders_DragOver"
                     Drop="LstFolders_Drop"
                     FontSize="13" Padding="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="2,4" VerticalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sidebar Buttons -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="110">
                <Button Content="添加目录" Click="BtnAdd_Click" Height="30" Margin="0,0,0,8"
                        Background="#3498DB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                <Button Content="移除所选" Click="BtnRemove_Click" Height="30" Margin="0,0,0,8"
                        Background="#E74C3C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                <Button Content="清空列表" Click="BtnClear_Click" Height="30"
                        Background="#7F8C8D" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Encoding Selection -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="预设:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#2C3E50"/>
                <ComboBox x:Name="cmbPreset" Width="150" Height="28"
                          SelectionChanged="CmbPreset_SelectionChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text=".stand 索引文件" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbStandEncoding" Width="130" Height="26"
                              SelectionChanged="CmbEncoding_SelectionChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text=".sinfo 分层文件" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbSinfoEncoding" Width="130" Height="26"
                              SelectionChanged="CmbEncoding_SelectionChanged"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text=".txt 图层文件" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbPbdEncoding" Width="130" Height="26"
                              SelectionChanged="CmbEncoding_SelectionChanged"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Click="BtnOk_Click" Width="85" Height="30" Margin="0,0,10,0"
                    Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="Bold" />
            <Button Content="取消" Click="BtnCancel_Click" Width="85" Height="30"
                    Background="#BDC3C7" Foreground="#2C3E50" BorderThickness="0" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>